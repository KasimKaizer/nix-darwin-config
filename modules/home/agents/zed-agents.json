{
  "context_servers": {
    "mcp-server-exa-search": {
      "enabled": true,
      "remote": false,
      "settings": { "exa_api_key": "@ZED_EXA_API_KEY@" }
    },
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": { "context7_api_key": "@ZED_CONTEXT7_API_KEY@" }
    },
    "mcp-server-grep-app": {
      "enabled": true,
      "remote": true,
      "url": "https://mcp.grep.app"
    },
    "mcp-server-sequential-thinking": {
      "enabled": true,
      "remote": false,
      "settings": {}
    },
    "nix": { "command": "@NIX_MCP_SERVER@", "args": [], "env": {} },
    "serena": { "command": "@SERENA_MCP_SERVER@", "args": [], "env": {} },
    "playwright": {
      "command": "@PLAYWRIGHT_MCP_SERVER@",
      "args": [],
      "env": {}
    },
    "codegraph": {
      "command": "@CODEGRAPH_MCP_SERVER@",
      "args": [],
      "env": {}
    }
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
      "default_config_options": {
        "mode": "agent-full-access",
        "model": "gpt-5.6-terra",
        "reasoning_effort": "xhigh"
      }
    },
    "antigravity-acp": {
      "type": "registry",
      "default_config_options": {
        "model": "gemini-3.7-flash-high"
      }
    },
    "opencode": {
      "type": "registry",
      "favorite_config_option_values": {
        "model": [
          "openai/gpt-5.6-terra",
          "cursor/kimi-k3",
          "cursor/grok-4.6",
          "google/antigravity-gemini-3.7-flash"
        ],
        "effort": ["Cursor Grok 4.6 Extra High", "Cursor Grok 4.6 High"]
      },
      "default_config_options": {
        "effort": "Cursor Grok 4.6 High",
        "model": "cursor/grok-4.6"
      }
    },
    "cursor": {
      "type": "registry",
      "default_mode": "agent",
      "favorite_config_option_values": { "model": ["grok-4.6", "kimi-k3"] },
      "default_config_options": {
        "effort": "xhigh",
        "fast": "false",
        "model": "grok-4.6"
      }
    },
    "github-copilot-cli": {
      "type": "registry",
      "default_config_options": { "reasoning_effort": "high" }
    }
  },
  "agent": {
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
        "enable_thinking": true,
        "effort": "max"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "xhigh"
      }
    ],
    "dock": "left",
    "model_parameters": [],
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
      "effort": "high"
    }
  },
  "disable_ai": false,
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
    "allow_data_collection": "no"
  }
}
